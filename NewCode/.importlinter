[importlinter]
root_packages =
    ttt
include_external_packages = True

# Layers are newline-separated, one ring per line. "|" would mean independent
# siblings in a single layer, which forbids app -> core rather than allowing it.
[importlinter:contract:rings]
name = inward-only dependencies
type = layers
layers =
    ttt.experiments
    ttt.cli
    ttt.app
    ttt.adapters
    ttt.ports
    ttt.extensions
    ttt.core

# A pure layers contract puts adapters below app, which would legalise
# app -> adapters. Ring 4 reaches the outside world only through the ports.
[importlinter:contract:app-never-touches-a-concrete-adapter]
name = app depends on ports, never on a concrete adapter
type = forbidden
source_modules =
    ttt.app
forbidden_modules =
    ttt.adapters

# The layers contract places cli above app and adapters, which would legalise
# cli -> either. Argument resolution is config arithmetic; it loads no model and
# opens no volume. Composition is ttt.experiments' job.
[importlinter:contract:cli-only-resolves-config]
name = cli resolves configuration and composes nothing
type = forbidden
source_modules =
    ttt.cli
forbidden_modules =
    ttt.app
    ttt.adapters
    ttt.ports

# D1: Ring 0 may import torch. D1's numpy.random half is enforced by the
# banned-idiom scan, since import-linter tracks externals at top level only.
[importlinter:contract:frameworks-out-of-inner-rings]
name = no frameworks in core, extensions, or ports
type = forbidden
source_modules =
    ttt.core
    ttt.extensions
    ttt.ports
forbidden_modules =
    transformers
    peft
    modal
    wandb
    datasets

# Ring 4 is tested entirely on fakes, so torch belongs behind the ports too.
# Indirect imports are allowed because D1 lets Ring 0 hold torch, and Ring 4
# reads core types and port protocols defined in it. A direct `import torch` in
# ttt/app/ is still a failure, which is what `make guard` proves.
[importlinter:contract:app-stays-framework-free]
name = app touches no framework directly
type = forbidden
allow_indirect_imports = True
source_modules =
    ttt.app
forbidden_modules =
    torch
    transformers
    peft
    modal
    wandb
    datasets
